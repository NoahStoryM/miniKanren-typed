;; Run unchanged against the installed module and the local copy.
(check-equal? (stream->list (stream 1 2 3)) '(1 2 3))
(check-equal? (stream->list (stream* 1 2 (stream 3))) '(1 2 3))
(check-equal? (stream->list (stream-map add1 (stream 1 2 3))) '(2 3 4))
(check-equal? (stream->list (stream-filter odd? (stream 1 2 3 4))) '(1 3))
(check-equal? (stream->list (stream-append (stream 1) empty-stream (stream 2))) '(1 2))
(check-equal? (stream->list (stream-add-between (stream 1 2) 'x)) '(1 x 2))
(check-equal? (stream->list (stream-take (stream 1 2 3) 2)) '(1 2))
(check-equal? (stream->list (stream-tail (stream 1 2 3) 1)) '(2 3))
(check-equal? (stream-ref (stream 1 2 3) 2) 3)
(check-equal? (stream-length (stream 1 2 3)) 3)
(check-equal? (stream-fold + 0 (stream 1 2 3)) 6)
(check-equal? (stream-count odd? (stream 1 2 3)) 2)
(check-true (stream-andmap positive? (stream 1 2)))
(check-true (stream-ormap even? (stream 1 2)))
(check-equal? (stream->list (for/stream ([i (in-range 3)]) i)) '(0 1 2))
(check-equal? (stream->list (for*/stream ([i '(1 2)] [j '(3 4)]) (+ i j))) '(4 5 5 6))
(check-equal? (match (stream 1 2) [(stream x y) (+ x y)]) 3)
(check-equal? (match (stream 1 2 3) [(stream* x tail) (stream->list tail)]) '(2 3))
(check-equal? (call-with-values (lambda () (stream-first (stream-cons (values 1 2) empty-stream))) list) '(1 2))
(check-equal? (call-with-values (lambda () (stream-first (stream-cons (values) empty-stream))) list) '())
(check-false (stream-first (stream #f)))
(define answer-procedure (lambda () 'answer))
(check-eq? (stream-first (stream answer-procedure)) answer-procedure)
(for ([mode '(lazy head tail both)])
  (define heads 0)
  (define tails 0)
  (define (head) (set! heads (add1 heads)) 7)
  (define (rest) (set! tails (add1 tails)) empty-stream)
  (define source
    (case mode
      [(lazy) (stream-cons (head) (rest))]
      [(head) (stream-cons #:eager (head) (rest))]
      [(tail) (stream-cons (head) #:eager (rest))]
      [(both) (stream-cons #:eager (head) #:eager (rest))]))
  (check-equal? heads (if (memq mode '(head both)) 1 0))
  (check-equal? tails (if (memq mode '(tail both)) 1 0))
  (check-equal? (stream->list source) '(7))
  (check-equal? (list heads tails) '(1 1)))
(define calls 0)
(define delayed (stream-lazy (begin (set! calls (add1 calls)) (stream 42))))
(check-equal? calls 0)
(check-false (stream-empty? delayed))
(check-equal? calls 1)
(check-equal? (stream->list delayed) '(42))
(check-equal? calls 1)
(define tail-calls 0)
(define tail-source (stream-cons #:eager 1 (begin (set! tail-calls (add1 tail-calls)) empty-stream)))
(define tail (stream-rest tail-source))
(check-equal? tail-calls 0)
(check-true (stream-empty? tail))
(check-equal? tail-calls 1)
(struct single (value)
  #:methods gen:stream
  [(define (stream-empty? s) #f)
   (define (stream-first s) (single-value s))
   (define (stream-rest s) empty-stream)])
(check-equal? (stream->list (single 'custom)) '(custom))
(check-equal? (stream->list '(1 2)) '(1 2))
(check-equal? (stream->list (contract (stream/c integer?) (stream 1 2) 'p 'n)) '(1 2))
(check-exn exn:fail:contract? (lambda () (stream-first (contract (stream/c integer?) (stream 'bad) 'p 'n))))
(check-exn exn:fail:contract? (lambda () (stream-first empty-stream)))
(check-exn exn:fail:contract? (lambda () (stream-ref (stream 1) 2)))
(define broken (stream-lazy 42))
(check-exn #rx"non-stream" (lambda () (stream-force broken)))
(check-exn #rx"reentrant or broken" (lambda () (stream-force broken)))
(define self (stream-lazy self))
(check-exn #rx"reentrant or broken" (lambda () (stream-force self)))
