#lang typed/racket/base

;; Compile before running. Input sizes are built at run time; three CPU-time
;; samples per size help distinguish per-node overhead from superlinear growth.
(require racket/list)
(define-type Literal (U Boolean Number Char Bytes String Keyword Null Symbol))
(define-type Data (U Literal (Pair Data Data)))
(define-type Narrow (U Symbol Null (Pair Narrow Narrow)))
(define-predicate wide? Data)
(define-predicate narrow? Narrow)
(: manual-wide? (-> Any Boolean : Data))
(define (manual-wide? v)
  (or (boolean? v) (number? v) (char? v) (bytes? v) (string? v)
      (keyword? v) (null? v) (symbol? v)
      (and (pair? v) (manual-wide? (car v)) (manual-wide? (cdr v)))))
(: numeric? (-> Any Boolean : Number))
(define-predicate numeric? Number)
(: run (-> (-> Any Boolean) Any Natural Integer))
(define (run p v count)
  (for/fold ([hits : Integer 0]) ([i (in-range count)])
    (if (p v) (add1 hits) hits)))
(: measure (-> (-> Any Boolean) Any Natural (Listof Integer)))
(define (measure p v count)
  (void (run p v count))
  (for/list : (Listof Integer) ([i (in-range 3)])
    (collect-garbage) (collect-garbage) (collect-garbage)
    (define start (current-process-milliseconds))
    (define hits (run p v count))
    (define elapsed (- (current-process-milliseconds) start))
    (unless (= hits count) (error 'measure "incorrect predicate"))
    elapsed))
(for ([n (in-list '(0 1 2 4 8 16 32 64))])
  (define specimen (make-list n 'a))
  (displayln (list n 'wide (measure wide? specimen 10000)
                    'narrow (measure narrow? specimen 10000)
                    'manual (measure manual-wide? specimen 10000))))
(displayln (list 'number-generated (measure numeric? 42 1000000)))
(displayln (list 'number-primitive (measure number? 42 1000000)))
