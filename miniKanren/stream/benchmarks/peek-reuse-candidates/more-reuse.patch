   (cond
-    [(eq? (stream-peek $1) empty-stream) $2]
+    [(eq? cached empty-stream) $2]
     [(stream-peek-first $1)
-     (stream-cons #:eager (car (stream-peek-first $1))
-                  #:eager (mplus (stream-peek-rest $1) $2))]
