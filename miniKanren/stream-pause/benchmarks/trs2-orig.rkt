#lang typed/racket
(require typed/miniKanren/trs2)
(defrel (ao x) (conde [(== x 'a)] [(ao x)]))
(defrel (alwayso) (conde [succeed] [(alwayso)]))
(defrel (nevero) (nevero))
(defrel (vr) (conde [(nevero)] [(vr)] [(alwayso)] [(vr)] [(nevero)]))
(: time-it (→ String (→ Any) Void))
(define (time-it name thk)
  (thk) (collect-garbage) (collect-garbage)
  (define t0 (current-process-milliseconds))
  (define r (thk))
  (printf "  ~a: ~a ms (~a)\n" name (- (current-process-milliseconds) t0) r))
(printf "trs2 original (typed)\n")
(time-it "answers 1e6" (λ () (length (run 1000000 q (ao q)))))
(time-it "very-recursiveo 1e5" (λ () (length (run 100000 q (vr)))))
